# Her gece 03:10 civarı (± 20 dk). Saat setup-backup.sh tarafından ownmemories-backup.timer.d/schedule.conf ile değiştirilir.
[Unit]
Description=OwnMemories gece yedeği zamanlayıcısı
# Yeni yedek kuruluysa ya da (geçiş dönemi) eski rsync yedeği ayarlıysa çalışır.
ConditionPathExists=|/etc/ownmemories/backup.env
ConditionPathExists=|/etc/ownmemories-backup.env

[Timer]
OnCalendar=*-*-* 03:10:00
RandomizedDelaySec=20min
Persistent=true

[Install]
WantedBy=timers.target
