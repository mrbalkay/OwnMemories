# OwnMemories iş kuyruğu işçisi (küçük resimler, Takeout içe aktarma)
# Kurulum: sudo cp ownmemories-worker.service /etc/systemd/system/ && sudo systemctl enable --now ownmemories-worker
[Unit]
Description=OwnMemories worker
After=network.target mysql.service mariadb.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/ownmemories
ExecStart=/usr/bin/php /var/www/ownmemories/bin/worker.php
Restart=always
RestartSec=5
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=multi-user.target
